# Smart Doorbell Hub -- Environment Configuration

# Camera Device Index (0 for primary webcam, 1 for external USB camera)
CAMERA_INDEX=0

# Telegram Bot Integration (Optional cloud notification dependency)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_CHAT_ID=your_chat_id_here

# Security Zone Mode: "individual" (1.2m zone, 2.0s dwell) or "apartment" (0.5m zone, 3.0s dwell)
MODE=individual

# Dual-Sensor Fusion Dwell Limits
TOF_ZONE_THRESHOLD_INDIVIDUAL=1200
TOF_ZONE_THRESHOLD_APARTMENT=500
TOF_DWELL_INDIVIDUAL=2.0
TOF_DWELL_APARTMENT=3.0

# Alert Rate-Limiting Cooldown (seconds)
ALERT_COOLDOWN=15

# Hardware Alarm Watchdog Timeout (seconds)
ALARM_TIMEOUT=5

# Network Ports
PORT=8000
ESP32_WS_PORT=8000
